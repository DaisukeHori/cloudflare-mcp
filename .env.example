# MCP接続認証キー（任意のランダム文字列）
MCP_API_KEY=cfmcp-your-random-key-here

# Cloudflare APIトークン（ダッシュボードで作成）
# 必要な権限: Tunnel Edit, Access Edit, Workers Edit, KV Edit, R2 Edit, Pages Edit,
#              Account Settings Read, Billing Read, Zone Read, Zone Settings Read, DNS Edit, SSL Read
CF_API_TOKEN=your-cloudflare-api-token

# CloudflareアカウントID（ダッシュボードのURLまたはゾーン概要ページから取得）
CF_ACCOUNT_ID=your-account-id
